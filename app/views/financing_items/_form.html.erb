<%= form_for(@financing_item) do |f| %>
  <% if @financing_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@financing_item.errors.count, "error") %> prohibited this financing_item from being saved:</h2>

      <ul>
      <% @financing_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  <input type="hidden" name="financing_item[financing_id]" value="<%= @financing_item.financing.id %>">
  <div class="field">
    <%= f.label :金额 %><br>
    <%= f.text_field :money_yuan %> 元
  </div>
  <div class="field">
    <label>资金往来</label><br>
    <select id="money_flow" name="money_flow" required="required">
      <option value="">请选择</option>
      <option value="balance">余额</option>
      <option value="outside">外部</option>
    </select>
  </div>
  <div class="field">
    <label>计价方式</label><br>
    <span><%= @financing_item.financing.twr? ? '时间加权(TWR)' : '原方式' %></span>
  </div>
  <div class="field">
    <%= f.label :资金进出前市值 %><br>
    <%= f.text_field :market_value_yuan %> 元
    <small>（资金进出前的账户总市值，TWR模式必填；进出后市值由系统根据金额自动计算）</small>
  </div>
  <div class="field">
    <%= f.label :支付时间 %><br>
    <%= f.datetime_select :paid_at %>
  </div>
  <div class="field">
    <%= f.label :计息时间 %><br>
    <%= f.date_select :interested_at %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
